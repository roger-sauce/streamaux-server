  "dependencies": {
    "playwright": "^1.47.0",
    "node-html-parser": "^9.0.0"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "eslint": "^10.7.0",
    "@types/node": "^20.19.0"
  },
  "allowScripts": {
    "fsevents@2.3.2": true
  }
}
