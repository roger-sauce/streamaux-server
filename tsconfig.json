{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "target": "ES2021",
    "module": "CommonJS",
    "lib": [
      "ES2021",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "typeRoots": [
      "apps/node_modules/@types"
    ],
    "strict": false,
    "skipLibCheck": true
  },
  "include": [
    "apps/adapters/**/*.js",
    "apps/autoplay-pi/**/*.js"
  ],
  "exclude": [
    "**/node_modules/**",
    "apps/autoplay-pi/public/**"
  ]
}